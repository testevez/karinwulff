---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadForm from '@/components/LeadForm.astro';
import TestimonialsSection from '@/components/TestimonialsSection.astro';
import heroPhoto from '../../photos/blue-ridge-mountains.jpg';
---

<BaseLayout
  title="AVL Curious — Asheville &amp; WNC Real Estate"
  description="A working buyer's guide to Asheville and Western North Carolina — neighborhoods, hidden corners, and homes worth seeing. With Karin Wulff, Realtor® at Nexus Realty."
>
  <!-- Hero -->
  <section class="border-b border-mountain-100 bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20 lg:grid lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-12">
      <div>
        <p class="text-xs uppercase tracking-widest text-sun-600">Asheville &middot; Western North Carolina</p>
        <h1 class="mt-3 max-w-4xl font-display text-5xl leading-[1.05] text-mountain-900 sm:text-6xl lg:text-7xl">
          Find the right home in Asheville.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-mountain-600 sm:text-xl">
          Buying in Western North Carolina is about more than square footage or listing photos.
          Every town, neighborhood, and mountain community has its own rhythm, tradeoffs, and personality.
        </p>
        <p class="mt-4 max-w-2xl text-lg text-mountain-600 sm:text-xl">
          AVL Curious helps buyers make smarter decisions about where to live, what to pay, and which
          homes are actually worth seeing — with local guidance from
          <strong class="text-mountain-800">Karin Wulff</strong>, Realtor® at Nexus Realty.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/contact/"
            style="color: #ffffff;"
            class="inline-flex items-center rounded-md bg-mountain-900 px-6 py-3 text-base font-semibold no-underline transition-colors hover:bg-sun-600"
          >
            Talk to Karin
          </a>
          <a
            href="/buy/"
            class="inline-flex items-center rounded-md border border-mountain-200 bg-white px-6 py-3 text-base font-medium text-mountain-900 no-underline transition-colors hover:border-sun-500 hover:text-sun-600"
          >
            How I Help Buyers
          </a>
        </div>
      </div>
      <div class="mt-12 lg:mt-0">
        <Image
          src={heroPhoto}
          alt="The Blue Ridge Mountains, Western North Carolina"
          width={1200}
          height={1500}
          loading="eager"
          fetchpriority="high"
          class="aspect-4/5 w-full rounded-lg object-cover shadow-lg"
        />
      </div>
    </div>
  </section>

  <!-- Brand pillars -->
  <section class="border-b border-mountain-100">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <h2 class="mt-3 max-w-3xl font-display text-3xl text-mountain-900 sm:text-4xl">
        What it’s like to work with Karin.
      </h2>

      <ul class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        <li>
          <h3 class="font-display text-xl text-mountain-900">Straightforward about value</h3>
          <p class="mt-2 text-mountain-600">
            I’ll tell you when a house is overpriced, when something feels off, and when a listing is actually worth moving quickly on. The goal isn’t just to buy a house — it’s to buy the right one.
          </p>
        </li>
        <li>
          <h3 class="font-display text-xl text-mountain-900">Knowledge that goes beyond Asheville</h3>
          <p class="mt-2 text-mountain-600">
            There are so many wonderful towns in the area surrounding Asheville. Based on your criteria, I can help you narrow down where you’ll actually feel at home before we start touring properties.
          </p>
        </li>
        <li>
          <h3 class="font-display text-xl text-mountain-900">Organized from contract to closing</h3>
          <p class="mt-2 text-mountain-600">
            Inspections, timelines, financing coordination, repair negotiations, contractors — I keep the process moving and make sure details don’t fall through the cracks.
          </p>
        </li>
        <li>
          <h3 class="font-display text-xl text-mountain-900">Strong connections</h3>
          <p class="mt-2 text-mountain-600">
            I can connect you with lenders, inspectors, attorneys, contractors, and other local professionals I trust — people who are responsive, honest, and good at what they do.
          </p>
        </li>
        <li>
          <h3 class="font-display text-xl text-mountain-900">Calm, low-pressure guidance</h3>
          <p class="mt-2 text-mountain-600">
            You won’t get sales pressure or manufactured urgency from me. I’ll give you honest feedback, clear communication, and enough space to make good decisions.
          </p>
        </li>
        <li>
          <h3 class="font-display text-xl text-mountain-900">Proven results</h3>
          <p class="mt-2 text-mountain-600">
            Consistent five-star reviews from buyers and sellers.
            <a href="/closed/" class="underline-offset-2 hover:text-sun-600">See the full record →</a>
          </p>
        </li>
      </ul>
    </div>
  </section>

  <TestimonialsSection
    heading="Five-star reviewed across every closing."
    background="cream"
  />

  <!-- Coming-soon callout for the tools -->
  <section class="border-b border-mountain-100 bg-mountain-900 text-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <p class="text-xs uppercase tracking-widest text-sun-300">Coming soon</p>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl">Three tools to help you decide.</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-3">
        <li class="rounded-md border border-mountain-600 p-6">
          <h3 class="font-display text-xl text-cream">Where should you live in WNC?</h3>
          <p class="mt-2 text-sm text-mountain-200">
            A short matcher that recommends 2–3 neighborhoods based on lot size, commute,
            outdoor priorities, and price tier — no demographic guessing.
          </p>
        </li>
        <li class="rounded-md border border-mountain-600 p-6">
          <h3 class="font-display text-xl text-cream">Are you ready to buy?</h3>
          <p class="mt-2 text-sm text-mountain-200">
            A self-assessment with concrete next steps if you're not quite there yet —
            including the lenders I'd introduce you to.
          </p>
        </li>
        <li class="rounded-md border border-mountain-600 p-6">
          <h3 class="font-display text-xl text-cream">Is your house ready to sell?</h3>
          <p class="mt-2 text-sm text-mountain-200">
            Prep checklist + a personalized timeline. Most "not-quite-ready" gaps are things
            I can run for you.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Lead form -->
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
      <LeadForm
        variant="hero"
        source="home-bottom"
        heading="Start a conversation."
        blurb="Tell me what you're looking for. I'll come back with neighborhoods to consider, listings worth a look, and an honest sense of whether the timing is right."
      />
    </div>
  </section>
</BaseLayout>
