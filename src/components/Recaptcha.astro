---
// Google reCAPTCHA v3 — invisible scoring captcha.
// Loads sitewide (per Google's recommendation, so the model can score
// behavior across the whole session). The token is then fetched per form
// submission inside LeadForm.astro and posted to Web3Forms, which
// validates it server-side using the matching SECRET key in the Web3Forms
// dashboard.
//
// If PUBLIC_RECAPTCHA_SITE_KEY is empty, no script loads and forms
// submit without a token (Web3Forms simply skips reCAPTCHA validation
// when none is configured).

const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

{siteKey && (
  <script is:inline async defer src={`https://www.google.com/recaptcha/api.js?render=${siteKey}`}></script>
)}
