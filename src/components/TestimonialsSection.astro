---
import { getCollection } from 'astro:content';

interface Props {
  heading?: string;
  blurb?: string;
  max?: number;
  background?: 'cream' | 'white';
}

const {
  heading = 'What clients say.',
  blurb = "Karin's clients on Zillow consistently describe the same three things: she's calm under pressure, she keeps it real, and she doesn't waste your time on the wrong houses.",
  max = 3,
  background = 'cream',
} = Astro.props;

const all = await getCollection('testimonials');
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = sorted.filter(t => t.data.featured).slice(0, max);

// Aggregate rating across ALL testimonials, not just the featured slice
const totalCount = sorted.length;
const avgRating =
  totalCount === 0 ? 0 : sorted.reduce((sum, t) => sum + t.data.rating, 0) / totalCount;

// No Review/AggregateRating JSON-LD here: these reviews come from Zillow, and
// Google's guidelines forbid marking up reviews sourced from third-party sites.
---

<section class:list={[
  'border-b border-mountain-100',
  background === 'cream' ? 'bg-cream' : 'bg-white',
]}>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs uppercase tracking-widest text-sun-600">Reviews</p>
        <h2 class="mt-3 max-w-3xl font-display text-3xl text-mountain-900 sm:text-4xl">
          {heading}
        </h2>
      </div>
      <a
        href="https://www.zillow.com/profile/wolfgrl1"
        target="_blank"
        rel="noopener"
        class="text-sm text-mountain-700 underline underline-offset-4 hover:text-sun-600"
      >
        Read all reviews on Zillow →
      </a>
    </div>

    {blurb && <p class="mt-4 max-w-2xl text-mountain-600">{blurb}</p>}

    <div class="mt-10 flex items-center gap-3 text-sm text-mountain-700">
      <span class="font-display text-3xl text-sun-600" aria-hidden="true">{avgRating.toFixed(1)}</span>
      <span aria-hidden="true">★ ★ ★ ★ ★</span>
      <span class="text-mountain-500">average across <strong>16</strong> verified Zillow closings</span>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {featured.map((t) => (
        <figure class="rounded-lg border border-mountain-200 bg-white p-6">
          <div class="text-sun-500" aria-label={`Rating: ${t.data.rating} out of 5 stars`}>
            {'★'.repeat(t.data.rating)}{'☆'.repeat(5 - t.data.rating)}
          </div>
          <blockquote class="mt-3 text-mountain-700">
            <p>{t.body?.trim().split('\n\n')[0]}</p>
          </blockquote>
          <figcaption class="mt-4 text-sm text-mountain-500">
            <span class="font-medium text-mountain-700">{t.data.reviewer_attribution}</span>
            <span class="block">{t.data.work_description} · {t.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
