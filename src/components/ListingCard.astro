---
import type { CollectionEntry } from 'astro:content';

interface Props {
  listing: CollectionEntry<'listings'>;
}

const { listing } = Astro.props;
const d = listing.data;

const priceFormatted = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
}).format(d.list_price);

const fmt = new Intl.NumberFormat('en-US');
const sqft = d.sqft ? `${fmt.format(d.sqft)} sqft` : null;
const lot = d.lot_acres ? `${d.lot_acres.toFixed(2)} ac` : null;

---

<article class="overflow-hidden rounded-lg border border-mountain-200 bg-white">
  <div class="relative aspect-4/3 overflow-hidden bg-mountain-100">
    <img
      src={d.hero_image}
      alt={`${d.title} — ${d.address.city}, ${d.address.state}`}
      loading="lazy"
      class="h-full w-full object-cover"
    />
    {d.badges && d.badges.length > 0 && (
      <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
        {d.badges.map((badge) => (
          <span class="rounded-full bg-sun-500 px-3 py-1 text-xs font-medium uppercase tracking-wider text-mountain-900 shadow-sm">
            {badge}
          </span>
        ))}
      </div>
    )}
  </div>
  <div class="p-5">
    <p class="font-display text-2xl text-mountain-900">{priceFormatted}</p>
    <p class="mt-1 font-medium text-mountain-800">{d.title}</p>
    <p class="mt-0.5 text-sm text-mountain-600">{d.neighborhood ?? d.address.city} · {d.address.city}, {d.address.state}</p>
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-mountain-700">
      <span><strong>{d.beds}</strong> bd</span>
      <span><strong>{d.baths}</strong> ba</span>
      {sqft && <span>{sqft}</span>}
      {lot && <span>{lot}</span>}
    </div>
  </div>
</article>
