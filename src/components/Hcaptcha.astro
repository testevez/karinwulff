---
// hCaptcha via Web3Forms's wrapper (zero-config on the free plan).
// On the free plan, Web3Forms supplies the hCaptcha site/secret key — we
// don't manage our own. The form widget is rendered with
// data-captcha="true" (NOT data-sitekey) and Web3Forms's wrapper script
// finds the markup, mounts the hCaptcha widget, and validates the
// h-captcha-response token server-side at submit time.
//
// PUBLIC_HCAPTCHA_ENABLED toggles the wrapper script + widget on/off.
// (Keeping the user's personal site key in .env as a comment for the
// future paid-plan migration path.)

const enabled = import.meta.env.PUBLIC_HCAPTCHA_ENABLED === 'true';
---

{enabled && (
  <script is:inline async defer src="https://web3forms.com/client/script.js"></script>
)}
