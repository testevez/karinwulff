---
// hCaptcha — privacy-friendly anti-bot CAPTCHA, natively supported by
// Web3Forms's free tier.
//
// The site key is public (embedded in the HTML); the SECRET key lives
// in the Web3Forms dashboard under Form Settings, where Web3Forms
// validates the h-captcha-response token server-side on each submit.
//
// If PUBLIC_HCAPTCHA_SITE_KEY is empty the script doesn't load and
// LeadForm.astro renders without the widget — submissions still go
// through (Web3Forms only enforces CAPTCHA when configured).

const siteKey = import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY;
---

{siteKey && (
  <script is:inline async defer src="https://js.hcaptcha.com/1/api.js"></script>
)}
