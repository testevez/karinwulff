---
// Sticky call/text bar for phones. Most real-estate browsing happens on
// mobile, and a tap-to-call is the shortest path to a lead. Hidden at md+.
// Taps are tracked as phone_click / text_click in Analytics.astro.
const phone = '+12017256428';
---

<nav
  aria-label="Contact Karin"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-mountain-600 bg-mountain-900 md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
>
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-3 px-4 py-3">
    <a
      href={`tel:${phone}`}
      style="color: #14181a;"
      class="flex items-center justify-center gap-2 rounded-md bg-sun-300 px-4 py-3 text-base font-semibold no-underline"
    >
      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
      </svg>
      Call Karin
    </a>
    <a
      href={`sms:${phone}`}
      style="color: #ffffff;"
      class="flex items-center justify-center gap-2 rounded-md border border-mountain-400 px-4 py-3 text-base font-semibold no-underline"
    >
      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
      </svg>
      Text Karin
    </a>
  </div>
</nav>
